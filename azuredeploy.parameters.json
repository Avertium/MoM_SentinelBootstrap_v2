{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "rgName": {
      "value": "<RESOURCE_GROUP_NAME>"
    },
    "location": {
      "value": "westus2"
    },
    "workspaceName": {
      "value": "<WORKSPACE_NAME>"
    },
    "pricingTier": {
      "value": "PerGB2018"
    },
    "capacityReservation": {
      "value": 100
    },
    "enableDataConnectors": {
      "value": [
        "AzureActiveDirectory",
        "AzureActivity",
        "Office365"
      ]
    },
    "severityLevels": {
      "value": [
        "High",
        "Medium"
      ]
    },
    "dailyQuota": {
      "value": 0
    },
    "dataRetention": {
      "value": 90
    },
    "immediatePurgeDataOn30Days": {
      "value": true
    },
    "enableSolutions1P": {
      "value": [
        "azuresentinel.azure-sentinel-solution-azureactivity",
        "azuresentinel.azure-sentinel-solution-azurekeyvault",
        "azuresentinel.azure-sentinel-solution-azurestorageaccount",
        "azuresentinel.azure-sentinel-solution-azurewebapplicationfirewal",
        "azuresentinel.azure-sentinel-solution-commoneventformat",
        "azuresentinel.azure-sentinel-solution-customlogsviaama",
        "azuresentinel.azure-sentinel-solution-azureactivedirectory",
        "azuresentinel.azure-sentinel-solution-microsoft365defender",
        "azuresentinel.azure-sentinel-solution-microsoftdefenderendpoint",
        "azuresentinel.azure-sentinel-solution-mdefenderforidentity",
        "azuresentinel.azure-sentinel-solution-microsoftdefenderforo365",
        "azuresentinel.azure-sentinel-solution-microsoftdefendercloudapps",
        "azuresentinel.azure-sentinel-solution-azureactivedirectoryip",
        "azuresentinel.azure-sentinel-solution-networksecuritygroup",
        "azuresentinel.azure-sentinel-solution-office365",
        "azuresentinel.azure-sentinel-solution-syslog",
        "azuresentinel.azure-sentinel-solution-threatintelligence-updated"
      ]
    },
    "enableSolutionsEssentials": {
      "value": [
        "azuresentinel.azure-sentinel-solution-attackertools",
        "azuresentinel.azure-sentinel-solution-cloudthreatdetection",
        "azuresentinel.azure-sentinel-solution-cloudservicedetection",
        "azuresentinel.azure-sentinel-solution-endpointthreat",
        "azuresentinel.azure-sentinel-solution-networksession",
        "azuresentinel.azure-sentinel-solution-networkthreatdetection",
        "microsoftsentinelcommunity.azure-sentinel-solution-sochandbook",
        "azuresentinel.azure-sentinel-solution-socprocessframework",
        "azuresentinel.azure-sentinel-solution-uebaessentials"
      ]
    },
    "enableSolutionsTraining": {
      "value": [
        "microsoftsentinelcommunity.azure-sentinel-solution-kqltraining",
        "Microsoft Sentinel Training Lab"
      ]
    },
    "aadStreams": {
      "value": [
        "SignInLogs",
        "AuditLogs",
        "NonInteractiveUserSignInLogs",
        "ServicePrincipalSignInLogs",
        "ManagedIdentitySignInLogs",
        "ProvisioningLogs",
        "ADFSSignInLogs",
        "UserRiskEvents",
        "RiskyUsers",
        "NetworkAccessTrafficLogs",
        "RiskyServicePrincipals",
        "ServicePrincipalRiskEvents",
        "MicrosoftGraphActivityLogs",
        "EnrichedOffice365AuditLogs",
        "RemoteNetworkHealthLogs"
      ]
    },
    "enableUeba": {
      "value": true
    },
    "identityProviders": {
      "value": [
        "AzureActiveDirectory"
      ]
    },
    "enableDiagnostics": {
      "value": true
    },
    "enableScheduledAlerts": {
      "value": true
    },
    "_artifactsLocation": {
      "value": "https://raw.githubusercontent.com/Avertium/MoM_SentinelBootstrap_v2/master/"
    },
    "enableXDRLighthouse": {
      "value": true
    },
    "mspTenantId": {
      "value": "<MANAGING_TENANT_ID>"
    }
  }
}